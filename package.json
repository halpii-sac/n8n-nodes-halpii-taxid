{
  "name": "n8n-nodes-halpii-taxid",
  "version": "0.1.0",
  "description": "n8n community node for HALPII Tax ID: validate business tax IDs (Peru RUC, Mexico RFC, Colombia NIT, EU VAT and more) against official registries where available.",
  "license": "MIT",
  "homepage": "https://taxid.halpii.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tax id",
    "vat",
    "ruc",
    "rfc",
    "nit",
    "kyb",
    "supplier verification"
  ],
  "author": {
    "name": "HALPII S.A.C.",
    "email": "contacto@halpii.com",
    "url": "https://taxid.halpii.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/halpii-sac/n8n-nodes-halpii-taxid.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HalpiiTaxIdApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/HalpiiTaxId/HalpiiTaxId.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.56.4",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/halpii-sac/n8n-nodes-halpii-taxid/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
